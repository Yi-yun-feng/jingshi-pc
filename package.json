{
  "name": "jingshi-pc",
  "version": "0.1.0",
  "description": "JingShi - professional symbols (LaTeX/Markdown) to chat-readable plain text. Desktop app (Tauri 2), platform-independent engine.",
  "type": "module",
  "license": "MIT",
  "main": "engine/jingshi.js",
  "types": "engine/jingshi.d.ts",
  "exports": {
    ".": {
      "types": "./engine/jingshi.d.ts",
      "import": "./engine/jingshi.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node engine/test.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6.0.3",
    "typescript": "~5.6.2"
  },
  "keywords": [
    "latex",
    "markdown",
    "plain-text",
    "unicode",
    "cleaner",
    "chat",
    "tauri"
